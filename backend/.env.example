# Neon PostgreSQL connection string (pooled for application traffic)
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=30&connection_limit=5

# Direct connection for Prisma migrations (non-pooled - remove "-pooler" from host)
DIRECT_URL=postgresql://neondb_owner:npg_password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30

# JWT Authentication
JWT_SECRET=meritx_super_secret_jwt_access_key_min_32_characters_long_2026
JWT_REFRESH_SECRET=meritx_super_secret_jwt_refresh_key_min_32_characters_long_2026
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Razorpay Test Mode Credentials (Leave blank if running without gateway)
RAZORPAY_KEY_ID=rzp_test_meritx_demo
RAZORPAY_KEY_SECRET=rzp_secret_demo_meritx_2026
RAZORPAY_WEBHOOK_SECRET=

# Brevo Transactional Email API (Student Email OTP)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email
BREVO_SENDER_NAME=LGW MeritX

# Financial Safety Feature Flags (Enforce compliance with Act 32 of 2025)
ENABLE_REAL_MONEY=false
ENABLE_REAL_WITHDRAWALS=false
ENABLE_PAID_ENTRY=false
ENABLE_CASH_PRIZES=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
